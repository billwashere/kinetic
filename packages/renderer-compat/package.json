{
  "name": "@kinetic/renderer-compat",
  "version": "1.0.0",
  "description": "MIT-licensed drop-in replacement for Remotion. Playwright + esbuild + FFmpeg.",
  "license": "MIT",
  "main": "./dist/react-api.js",
  "types": "./dist/react-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-api.d.ts",
      "default": "./dist/react-api.js"
    },
    "./bundler": {
      "types": "./dist/bundler.d.ts",
      "default": "./dist/bundler.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "esbuild": "^0.21.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.1.0",
    "playwright": "^1.40.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [],
  "author": ""
}
