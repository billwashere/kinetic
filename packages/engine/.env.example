# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.

# ── Pipeline ──────────────────────────────────────────────────────────────────

# Version tag — controls output directory namespacing (e.g. v1.0, v2.0)
DOCS_VERSION=v1.0

# ── Primary application URL ───────────────────────────────────────────────────
#
# APP_URL is Playwright's baseURL — relative paths in tests resolve here.
#
# Switch environments by changing this value only:
#   APP_URL=http://localhost:3000       ← local dev (default)
#   APP_URL=https://staging.myapp.com  ← staging
#   APP_URL=https://myapp.com          ← production

APP_URL=http://localhost:3000

# ── Additional built-in service URLs ─────────────────────────────────────────
#
# These default to APP_URL if not set (single-domain apps need only APP_URL).

AUTH_URL=
ADMIN_URL=

# ── Integration service URLs and credentials ──────────────────────────────────
#
# For cross-domain integration tests, add a <NAME>_URL for each external service.
# The naming convention is strict: loadService('xyz') reads XYZ_URL from here.
#
# Credentials are per-service. The global setup script (e2e-tests/global-setup.ts)
# reads these, logs in once, and saves the session to .auth/<service>.json.
# Subsequent test runs restore the saved session instead of re-logging in.
#
# Example: testing that work done in au.xyz.com is reflected in abc.com

XYZ_URL=
XYZ_EMAIL=
XYZ_PASSWORD=

ABC_URL=
ABC_EMAIL=
ABC_PASSWORD=

# ── Remotion render configuration ────────────────────────────────────────────
#
# All values are optional — sensible defaults are applied when not set.
#
# RENDER_CODEC
#   Output video codec. Options: h264 (default), h265, vp9, vp8
#   h264  — widest compatibility, good quality. Best for docs.
#   h265  — ~40% smaller files than h264; slower to encode; not universally supported.
#   vp9   — royalty-free, good browser support, slower to encode.
#
# RENDER_CRF
#   Constant Rate Factor — quality vs file size (lower = better quality, larger file).
#   h264/h265 range: 0–51. vp9 range: 0–63. Default: 18 (high quality).
#   For CI where file size doesn't matter: 18. For release builds: 23.
#
# RENDER_PRESET
#   Encoding speed for h264/h265. Does NOT affect quality — only encode time vs file size.
#   Options: ultrafast, superfast, veryfast, faster, fast, medium (default), slow, slower, veryslow
#   CI recommendation: ultrafast  |  Release recommendation: slow
#
# RENDER_CONCURRENCY
#   Number of browser tabs Remotion opens in parallel.
#   Default: half your CPU core count. Increase for faster renders on beefy machines.
#
# RENDER_LEAD_IN_SECONDS
#   Seconds of silence before the first narration step. Default: 1.0
#
# RENDER_LEAD_OUT_SECONDS
#   Seconds of silence after the last narration step. Default: 2.0

RENDER_CODEC=
RENDER_CRF=
RENDER_PRESET=
RENDER_CONCURRENCY=
RENDER_LEAD_IN_SECONDS=
RENDER_LEAD_OUT_SECONDS=

# ── TTS adapter selection ─────────────────────────────────────────────────────
#
# Controls which text-to-speech engine the pipeline uses.
#
#   openai  — OpenAI TTS API (requires OPENAI_API_KEY, best quality)
#   kokoro  — Kokoro-82M local model (no API key, ~90 MB download on first run)
#   null    — Silent placeholder (for CI runs that skip audio generation)
#
# Auto-detection when TTS_ADAPTER is not set:
#   OPENAI_API_KEY present → openai
#   Otherwise              → kokoro
#
# The Kokoro model caches to ~/.cache/huggingface/hub/ after the first download.
# Delete that directory to force a fresh download.

TTS_ADAPTER=

# ── OpenAI TTS ────────────────────────────────────────────────────────────────

# Leave empty to use the silent NullTTSAdapter (no API calls, no audio).
OPENAI_API_KEY=

# Optional: override for enterprise proxies or local model servers.
OPENAI_BASE_URL=

# ── Diff thresholds ───────────────────────────────────────────────────────────

# Anchor drift in pixels that triggers a warning / breaking finding in diff:check.
# Increase if your app has animated transitions that shift elements by a few pixels.
ANCHOR_WARN_PX=20
ANCHOR_FAIL_PX=100
