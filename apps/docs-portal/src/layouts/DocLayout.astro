---
import {
  SITE,
  LOCALE_LABELS,
  LOCALE_NAMES,
  themeStyleTag,
  uiStrings,
  siteUrl,
  faviconHref,
  type UiStrings,
} from '../config';
import fs from 'fs-extra';
import path from 'path';
import {
  BookOpen,
  ChevronDown,
  ChevronRight,
  FileText,
  Folder,
  House,
  Menu,
  Moon,
  Search,
  Sun,
} from 'lucide-react';

// Plugin HTML files live OUTSIDE the subtree — read from paths specified via
// env vars, or fall back to the bundled stub files inside the subtree.
async function readPlugin(envVar: string, internalFallback: string): Promise<string> {
  const external = process.env[envVar];
  if (external) {
    return fs.readFile(path.resolve(external), 'utf8').catch(() => '');
  }
  // Fall back to the stub file bundled inside the subtree (safe empty stubs)
  return fs.readFile(path.resolve(import.meta.dirname, internalFallback), 'utf8').catch(() => '');
}

const [headHtml, bodyStartHtml, sidebarHtml] = await Promise.all([
  readPlugin('KINETIC_PLUGIN_HEAD', '../plugins/HeadInject.astro'),
  readPlugin('KINETIC_PLUGIN_BODY_START', '../plugins/BodyStartInject.astro'),
  readPlugin('KINETIC_PLUGIN_SIDEBAR', '../plugins/SidebarInject.astro'),
]);

export interface NavPage {
  id: string;
  title: string;
  url: string;
  /** breadcrumbs[0] — top-level sidebar heading. */
  group: string;
  /** breadcrumbs[1] — collapsible area within the group, if any. */
  subgroup: string | null;
}

export interface Section {
  /** Diátaxis quadrant; the label comes from the UI strings. */
  key: 'guides' | 'howTo' | 'tutorials' | 'explanation';
  url: string;
  active: boolean;
}

export interface SearchEntry {
  url: string;
  title: string;
  summary: string;
  kind: string;
}

interface AdjacentPage {
  url: string;
  title: string;
}

interface Props {
  title: string;
  description?: string;
  descriptionHtml?: string;
  dir: string;
  lang: string;
  allVersions: string[];
  currentVersion: string;
  versionUrls: Record<string, string>;
  allLocales: string[];
  currentLocale: string;
  menuItems: NavPage[];
  currentPageId: string;
  breadcrumbs: string[];
  prevPage: AdjacentPage | null;
  nextPage: AdjacentPage | null;
  /** Relative path from this page to the site root, e.g. '../../../'. */
  root: string;
  sections: Section[];
  searchEntries: SearchEntry[];
}

const {
  title,
  description,
  descriptionHtml,
  dir,
  lang,
  allVersions,
  currentVersion,
  versionUrls,
  allLocales,
  currentLocale,
  menuItems,
  currentPageId,
  breadcrumbs,
  prevPage,
  nextPage,
  root,
  sections,
  searchEntries,
} = Astro.props;

const ui: UiStrings = uiStrings(currentLocale);
const metaDescription = description ?? SITE.description;
const favicon = faviconHref(root);
const logo = SITE.logo ? siteUrl(root, SITE.logo) : '';
const activeSection = sections.find((s) => s.active);

// Sidebar tree: group (breadcrumbs[0]) → subgroup (breadcrumbs[1]) → pages, in skeleton order.
type Subgroup = { name: string | null; pages: NavPage[]; current: boolean };
const groups: { name: string; subgroups: Subgroup[] }[] = [];
for (const item of menuItems) {
  let g = groups.find((x) => x.name === item.group);
  if (!g) groups.push((g = { name: item.group, subgroups: [] }));
  let sg = g.subgroups.find((x) => x.name === item.subgroup);
  if (!sg) g.subgroups.push((sg = { name: item.subgroup, pages: [], current: false }));
  sg.pages.push(item);
  if (item.id === currentPageId) sg.current = true;
}
// Breadcrumb separators point in reading direction via rtl:rotate-180.
const Chevron = ChevronRight;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={`${title} | ${SITE.name}`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    {favicon && <link rel="icon" href={favicon} sizes="any" />}
    <title>{title} | {SITE.name}</title>

    <!-- Apply the saved or OS colour scheme before first paint to avoid a light flash. -->
    <script is:inline>
      (function () {
        var mode = null;
        try {
          mode = localStorage.getItem('kinetic-theme');
        } catch (e) {}
        if (mode === 'dark' || (!mode && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Theme: CSS custom properties derived from THEME in config.ts.
         Change THEME.primary (and its tints) to rebrand the portal. -->
    <Fragment set:html={themeStyleTag()} />

    <!-- Semantic classes that reference the theme variables, so a rebrand cascades everywhere. -->
    <style is:global>
      .k-text-primary {
        color: var(--kinetic-primary);
      }
      .dark .k-text-primary {
        /* The brand colour is too dark on slate-900; lighten it for AA contrast. */
        color: color-mix(in srgb, var(--kinetic-primary) 45%, #ffffff);
      }
      .k-bg-primary {
        background-color: var(--kinetic-primary);
        color: #ffffff;
      }
      .k-bg-primary-light {
        background-color: var(--kinetic-primary-light);
      }
      .k-border-primary-mid {
        border-color: var(--kinetic-primary-mid);
      }
      .k-tab-active {
        border-color: var(--kinetic-primary);
      }
      .kinetic-focus:focus-visible,
      .k-focus:focus-visible {
        outline: 2px solid var(--kinetic-primary);
        outline-offset: 2px;
      }
    </style>

    <!-- Plugin injection point: analytics, fonts, custom meta tags -->
    <Fragment set:html={headHtml} />
  </head>

  <body
    class="bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans min-h-screen antialiased"
  >
    <!-- Plugin injection point: chat widgets, cookie consent, GTM body tag -->
    <Fragment set:html={bodyStartHtml} />

    <!-- ── Header ─────────────────────────────────────────────────── -->
    <header
      class="sticky top-0 z-40 h-16 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-slate-800 dark:bg-slate-950/95"
    >
      <div class="flex h-full items-center gap-4 px-4 md:px-6">
        <button
          id="nav-toggle"
          type="button"
          aria-label={ui.openNav}
          data-label-open={ui.openNav}
          data-label-close={ui.closeNav}
          aria-expanded="false"
          aria-controls="sidebar"
          class="md:hidden flex-shrink-0 rounded-md p-1.5 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 k-focus"
        >
          <Menu className="h-5 w-5" aria-hidden="true" />
        </button>

        <a
          href={root}
          class="flex items-center gap-2 flex-shrink-0 k-focus rounded"
          aria-label={SITE.name}
        >
          {
            logo ? (
              <img src={logo} alt={SITE.name} class="h-7 w-auto" />
            ) : (
              <>
                <BookOpen className="h-7 w-7 k-text-primary" aria-hidden="true" />
                <span class="hidden text-xl font-bold tracking-tight sm:inline">{SITE.name}</span>
              </>
            )
          }
        </a>

        <nav aria-label={ui.primaryNav} class="hidden lg:block h-full ms-6">
          <ul class="flex h-full items-stretch gap-6">
            {
              sections.map((s) => (
                <li class="flex">
                  <a
                    href={s.url}
                    aria-current={s.active ? 'page' : undefined}
                    class={
                      'flex items-center border-b-2 text-sm font-medium transition-colors k-focus ' +
                      (s.active
                        ? 'k-tab-active k-text-primary'
                        : 'border-transparent text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white')
                    }
                  >
                    {ui[s.key]}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ms-auto flex items-center gap-2">
          <div class="relative" id="search-root">
            <label for="site-search" class="sr-only">{ui.search}</label>
            <div class="relative">
              <Search
                className="pointer-events-none absolute start-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500 dark:text-slate-400"
                aria-hidden="true"
              />
              <input
                id="site-search"
                type="search"
                autocomplete="off"
                placeholder={`${ui.search}…`}
                aria-describedby="search-status"
                class="w-36 sm:w-72 rounded-lg border border-slate-300 bg-white py-2 ps-9 pe-12 text-sm placeholder:text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:placeholder:text-slate-400 k-focus"
              />
              <kbd
                class="pointer-events-none absolute end-2 top-1/2 hidden -translate-y-1/2 rounded border border-slate-300 px-1.5 text-[11px] font-medium text-slate-600 sm:block dark:border-slate-600 dark:text-slate-300"
                aria-hidden="true">⌘K</kbd
              >
            </div>
            <p id="search-status" class="sr-only" aria-live="polite"></p>
            <div
              id="search-panel"
              hidden
              class="absolute end-0 mt-2 w-80 max-w-[90vw] rounded-lg border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900"
            >
              <ul
                id="search-results"
                aria-label={ui.searchResults}
                class="max-h-96 overflow-y-auto"
              >
              </ul>
            </div>
            <script
              type="application/json"
              id="search-data"
              set:html={JSON.stringify({ entries: searchEntries, noResults: ui.noResults })}
            />
          </div>

          <button
            id="theme-toggle"
            type="button"
            aria-pressed="false"
            aria-label={ui.darkMode}
            class="rounded-md p-2 text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800 k-focus"
          >
            <Moon className="h-5 w-5 dark:hidden" aria-hidden="true" />
            <Sun className="hidden h-5 w-5 dark:block" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>

    <!-- ── Backdrop (mobile only) ──────────────────────────────────── -->
    <div id="backdrop" class="fixed inset-0 z-20 bg-black/40 hidden md:hidden" aria-hidden="true">
    </div>

    <div class="flex">
      <!-- ── Sidebar ───────────────────────────────────────────────── -->
      <aside
        id="sidebar"
        class="fixed top-16 bottom-0 start-0 z-30 w-72 flex flex-col border-e border-slate-200 bg-white
               -translate-x-full rtl:translate-x-full transition-transform duration-200 ease-in-out
               dark:border-slate-800 dark:bg-slate-950
               md:sticky md:top-16 md:h-[calc(100vh-4rem)] md:translate-x-0 rtl:md:translate-x-0"
      >
        <nav class="flex-1 overflow-y-auto px-4 py-6" aria-label={ui.pagesNav}>
          {
            groups.map((g) => (
              <div class="mb-6">
                <p class="mb-2 px-3 text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                  {g.name}
                </p>
                <ul class="space-y-0.5">
                  {g.subgroups.map((sg) =>
                    sg.name ? (
                      <li>
                        <details open={sg.current} class="group">
                          <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800 k-focus [&::-webkit-details-marker]:hidden">
                            <Folder
                              className="h-4 w-4 flex-shrink-0 text-slate-500 dark:text-slate-400"
                              aria-hidden="true"
                            />
                            <span class="flex-1">{sg.name}</span>
                            <ChevronDown
                              className="h-4 w-4 text-slate-500 transition-transform group-open:rotate-180"
                              aria-hidden="true"
                            />
                          </summary>
                          <ul class="mt-0.5 space-y-0.5 ps-4">
                            {sg.pages.map((item) => (
                              <li>
                                <a
                                  href={item.url}
                                  aria-current={item.id === currentPageId ? 'page' : undefined}
                                  class={
                                    'flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm transition-colors k-focus ' +
                                    (item.id === currentPageId
                                      ? 'k-bg-primary-light k-text-primary font-medium'
                                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white')
                                  }
                                >
                                  <FileText className="h-4 w-4 flex-shrink-0" aria-hidden="true" />
                                  <span>{item.title}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      </li>
                    ) : (
                      sg.pages.map((item) => (
                        <li>
                          <a
                            href={item.url}
                            aria-current={item.id === currentPageId ? 'page' : undefined}
                            class={
                              'flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm transition-colors k-focus ' +
                              (item.id === currentPageId
                                ? 'k-bg-primary-light k-text-primary font-medium'
                                : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800')
                            }
                          >
                            <FileText className="h-4 w-4 flex-shrink-0" aria-hidden="true" />
                            <span>{item.title}</span>
                          </a>
                        </li>
                      ))
                    ),
                  )}
                </ul>
              </div>
            ))
          }

          <!-- Plugin injection point: external links, notices -->
          <Fragment set:html={sidebarHtml} />
        </nav>

        <!-- Sidebar footer: locale + version switchers -->
        <div class="flex-shrink-0 space-y-3 border-t border-slate-200 p-4 dark:border-slate-800">
          {
            allLocales.length > 1 && (
              <div>
                <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                  {ui.language}
                </p>
                <div class="flex flex-wrap gap-1.5" role="group" aria-label={ui.language}>
                  {allLocales.map((loc) => (
                    <a
                      href={`${root}${currentVersion}/${loc}/${currentPageId}/`}
                      lang={loc}
                      aria-label={LOCALE_NAMES[loc] ?? loc}
                      aria-current={loc === currentLocale ? 'true' : undefined}
                      class={
                        'rounded-md px-2.5 py-1 text-xs font-semibold transition-colors k-focus ' +
                        (loc === currentLocale
                          ? 'k-bg-primary'
                          : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700')
                      }
                    >
                      {LOCALE_LABELS[loc] ?? loc}
                    </a>
                  ))}
                </div>
              </div>
            )
          }
          {
            allVersions.length > 1 && (
              <div>
                <label
                  for="version-select"
                  class="mb-2 block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400"
                >
                  {ui.version}
                </label>
                <select
                  id="version-select"
                  data-version-urls={JSON.stringify(versionUrls)}
                  class="w-full cursor-pointer rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm font-medium dark:border-slate-700 dark:bg-slate-900 k-focus"
                >
                  {allVersions.map((v) => (
                    <option value={v} selected={v === currentVersion}>
                      {v}
                    </option>
                  ))}
                </select>
              </div>
            )
          }
        </div>
      </aside>

      <!-- ── Main + right rail ───────────────────────────────────────── -->
      <div class="flex min-w-0 flex-1 justify-center gap-10 px-4 py-8 md:px-10">
        <main class="min-w-0 max-w-3xl flex-1">
          {
            breadcrumbs.length > 0 && (
              <nav aria-label={ui.breadcrumb} class="mb-6">
                <ol class="flex flex-wrap items-center gap-1.5 text-sm text-slate-600 dark:text-slate-400">
                  <li>
                    <a
                      href={root}
                      class="flex items-center hover:text-slate-900 dark:hover:text-white k-focus rounded"
                    >
                      <House className="h-4 w-4" aria-hidden="true" />
                      <span class="sr-only">{ui.home}</span>
                    </a>
                  </li>
                  {activeSection && (
                    <li class="flex items-center gap-1.5">
                      <Chevron className="h-3.5 w-3.5 rtl:rotate-180" aria-hidden="true" />
                      <a
                        href={activeSection.url}
                        class="hover:text-slate-900 dark:hover:text-white k-focus rounded"
                      >
                        {ui[activeSection.key]}
                      </a>
                    </li>
                  )}
                  {breadcrumbs.map((crumb) => (
                    <li class="flex items-center gap-1.5">
                      <Chevron className="h-3.5 w-3.5 rtl:rotate-180" aria-hidden="true" />
                      <span>{crumb}</span>
                    </li>
                  ))}
                  <li class="flex items-center gap-1.5">
                    <Chevron className="h-3.5 w-3.5 rtl:rotate-180" aria-hidden="true" />
                    <span
                      aria-current="page"
                      class="font-medium text-slate-900 dark:text-slate-100"
                    >
                      {title}
                    </span>
                  </li>
                </ol>
              </nav>
            )
          }

          <header class="mb-8 flex items-start gap-4">
            <span
              class="hidden sm:flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-xl border border-slate-200 text-slate-600 dark:border-slate-700 dark:text-slate-300"
              aria-hidden="true"
            >
              <FileText className="h-8 w-8" strokeWidth={1.5} />
            </span>
            <div>
              <h1
                class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
              >
                {title}
              </h1>
              {
                descriptionHtml && (
                  <p
                    class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300"
                    set:html={descriptionHtml}
                  />
                )
              }
            </div>
          </header>

          <article>
            <slot />
          </article>

          <!-- Plugin injection point: feedback, related pages, comments -->
          <slot name="page-inject" />

          {
            (prevPage || nextPage) && (
              <nav
                aria-label={ui.pageNav}
                class="mt-16 grid grid-cols-2 gap-4 border-t border-slate-200 pt-6 dark:border-slate-800"
              >
                <div>
                  {prevPage && (
                    <a
                      href={prevPage.url}
                      class="flex flex-col gap-1 rounded-xl border border-slate-200 p-4 transition-all hover:shadow-sm dark:border-slate-800 k-focus"
                    >
                      <span class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                        {ui.previous}
                      </span>
                      <span class="text-sm font-semibold text-slate-800 line-clamp-2 dark:text-slate-100">
                        {prevPage.title}
                      </span>
                    </a>
                  )}
                </div>
                <div class="flex justify-end">
                  {nextPage && (
                    <a
                      href={nextPage.url}
                      class="flex w-full flex-col gap-1 rounded-xl border border-slate-200 p-4 text-end transition-all hover:shadow-sm dark:border-slate-800 k-focus"
                    >
                      <span class="text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-400">
                        {ui.next}
                      </span>
                      <span class="text-sm font-semibold text-slate-800 line-clamp-2 dark:text-slate-100">
                        {nextPage.title}
                      </span>
                    </a>
                  )}
                </div>
              </nav>
            )
          }
        </main>

        {
          Astro.slots.has('rail') && (
            <aside class="hidden w-72 flex-shrink-0 xl:block" aria-label={ui.onThisPage}>
              <div class="sticky top-24 space-y-6">
                <slot name="rail" />
              </div>
            </aside>
          )
        }
      </div>
    </div>

    <script>
      import { buildSearchIndex, search } from '../../../../packages/engine/src/knowledge/search';

      // ── Mobile navigation ──
      const toggle = document.getElementById('nav-toggle');
      const sidebar = document.getElementById('sidebar');
      const backdrop = document.getElementById('backdrop');
      const rtl = document.documentElement.dir === 'rtl';
      const hiddenClass = rtl ? 'translate-x-full' : '-translate-x-full';

      function openNav() {
        sidebar?.classList.remove(hiddenClass);
        backdrop?.classList.remove('hidden');
        toggle?.setAttribute('aria-expanded', 'true');
        toggle?.setAttribute('aria-label', toggle.dataset.labelClose ?? '');
      }
      function closeNav() {
        sidebar?.classList.add(hiddenClass);
        backdrop?.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
        toggle?.setAttribute('aria-label', toggle.dataset.labelOpen ?? '');
      }
      toggle?.addEventListener('click', () => {
        toggle.getAttribute('aria-expanded') === 'true' ? closeNav() : openNav();
      });
      backdrop?.addEventListener('click', closeNav);

      // ── Version switcher ──
      const versionSelect = document.getElementById('version-select') as HTMLSelectElement | null;
      if (versionSelect) {
        const urls: Record<string, string> = JSON.parse(versionSelect.dataset.versionUrls ?? '{}');
        versionSelect.addEventListener('change', () => {
          const url = urls[versionSelect.value];
          if (url) window.location.href = url;
        });
      }

      // ── Dark mode ──
      const themeToggle = document.getElementById('theme-toggle');
      const syncTheme = () =>
        themeToggle?.setAttribute(
          'aria-pressed',
          String(document.documentElement.classList.contains('dark')),
        );
      syncTheme();
      themeToggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('kinetic-theme', dark ? 'dark' : 'light');
        } catch {
          /* storage may be blocked; the choice still applies to this page */
        }
        syncTheme();
      });

      // ── Search: same tokenizer/ranking as the knowledge index, over pages + concepts ──
      const input = document.getElementById('site-search') as HTMLInputElement | null;
      const panel = document.getElementById('search-panel');
      const list = document.getElementById('search-results');
      const status = document.getElementById('search-status');
      const raw = document.getElementById('search-data')?.textContent ?? '{}';
      const data: {
        entries: { url: string; title: string; summary: string; kind: string }[];
        noResults: string;
      } = JSON.parse(raw);
      const index = buildSearchIndex(
        document.documentElement.lang,
        data.entries.map((e) => ({ id: e.url, kind: e.kind, title: e.title, summary: e.summary })),
      );

      const links = () => Array.from(list?.querySelectorAll('a') ?? []);
      function render() {
        if (!input || !panel || !list || !status) return;
        const q = input.value.trim();
        if (!q) {
          panel.hidden = true;
          status.textContent = '';
          return;
        }
        const hits = search(index, q, { limit: 8 });
        list.replaceChildren(
          ...hits.map((h) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = h.doc.id;
            a.className =
              'block rounded-md px-3 py-2 text-sm hover:bg-slate-100 focus:bg-slate-100 dark:hover:bg-slate-800 dark:focus:bg-slate-800 k-focus';
            const t = document.createElement('span');
            t.className = 'block font-medium text-slate-900 dark:text-slate-100';
            t.textContent = h.doc.title;
            const s = document.createElement('span');
            s.className = 'block text-xs text-slate-600 dark:text-slate-400 line-clamp-2';
            s.textContent = h.doc.summary;
            a.append(t, s);
            li.append(a);
            return li;
          }),
        );
        if (hits.length === 0) {
          const li = document.createElement('li');
          li.className = 'px-3 py-2 text-sm text-slate-600 dark:text-slate-400';
          li.textContent = data.noResults;
          list.append(li);
        }
        status.textContent = hits.length ? `${hits.length}` : data.noResults;
        panel.hidden = false;
      }
      input?.addEventListener('input', render);
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          links()[0]?.focus();
        }
      });
      list?.addEventListener('keydown', (e) => {
        const all = links();
        const i = all.indexOf(document.activeElement as HTMLAnchorElement);
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          all[Math.min(i + 1, all.length - 1)]?.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          i <= 0 ? input?.focus() : all[i - 1].focus();
        }
      });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          input?.focus();
        } else if (e.key === 'Escape') {
          closeNav();
          if (panel && !panel.hidden) {
            panel.hidden = true;
            input?.focus();
          }
        }
      });
      document.addEventListener('click', (e) => {
        if (panel && !document.getElementById('search-root')?.contains(e.target as Node))
          panel.hidden = true;
      });
    </script>
  </body>
</html>
