---
import { SITE } from '../config';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found | {SITE.name}</title>
  </head>
  <body class="min-h-screen bg-slate-50 flex items-center justify-center font-sans text-slate-900">
    <div class="text-center px-6">
      <div class="text-8xl font-black text-slate-200 mb-4">404</div>
      <h1 class="text-2xl font-bold mb-2">Page not found</h1>
      <p class="text-slate-500 mb-8">
        This page may have been moved or doesn't exist in this version.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 bg-blue-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-blue-700 transition-colors"
      >
        ← Back to docs
      </a>
    </div>
  </body>
</html>
