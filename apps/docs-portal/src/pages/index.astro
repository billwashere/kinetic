---
/**
 * Home page. Lists the authored user guides (grouped by category) and the recorded walkthroughs,
 * with a link to the knowledge explorer. With no knowledge or pages built it falls back to a
 * "not built" message. All links are relative so any base path works.
 */
import fs from 'fs-extra';
import { dirs } from '../lib/workspace.mjs';
import path from 'path';
import { BookOpen, Compass, FileText, PlayCircle } from 'lucide-react';
import { SITE, themeStyleTag, siteUrl, faviconHref } from '../config';
import { loadKnowledge, guidesFor } from '../lib/knowledge';
import { groupGuides, DOC_TYPE_LABELS } from '../lib/guides';

const generatedDir =
  dirs.generated;
const localesDir =
  dirs.locales;
const explorerPath = process.env.KINETIC_EXPLORER_PATH ?? '../explorer/';

const knowledge = loadKnowledge();
let locale = 'en-US';
let walkthroughs: { title: string; description: string; url: string }[] = [];
try {
  locale =
    (await fs.readdir(localesDir)).filter((f: string) => f.endsWith('.json')).sort()[0]?.replace('.json', '') ??
    locale;
  const versions = (await fs.readdir(generatedDir)).sort();
  const version = knowledge?.docsVersion ?? versions[versions.length - 1];
  const skeleton = await fs.readJson(path.join(generatedDir, version, 'extracted-skeleton.json'));
  const pages = (await fs.readJson(path.join(localesDir, `${locale}.json`))).pages ?? {};
  walkthroughs = skeleton.map((p: any) => ({
    title: pages[p.pageId]?.title ?? p.pageId,
    description: (pages[p.pageId]?.description ?? '').replace(/\*\*|__|[*_`]/g, ''),
    url: `./${version}/${locale}/${p.pageId}/`,
  }));
} catch {
  /* no walkthroughs built */
}
const version = knowledge?.docsVersion;
const guides = knowledge ? guidesFor(knowledge, locale) : [];
const groups = groupGuides(guides);
const guideUrl = (slug: string) => `./${version}/${locale}/guides/${slug}/`;
const firstGuide = guides[0] ? guideUrl(guides[0].slug) : walkthroughs[0]?.url;
const card =
  'block rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-400 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-600 k-focus';
---

<html lang={locale.split('-')[0]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={SITE.description} />
    {faviconHref('./') && <link rel="icon" href={faviconHref('./')} sizes="any" />}
    <title>{SITE.name}</title>
    <script is:inline>
      (function () {
        var mode = null;
        try {
          mode = localStorage.getItem('kinetic-theme');
        } catch (e) {}
        if (mode === 'dark' || (!mode && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <Fragment set:html={themeStyleTag()} />
    <style is:global>
      .k-text-primary { color: var(--kinetic-primary); }
      .dark .k-text-primary { color: color-mix(in srgb, var(--kinetic-primary) 45%, #ffffff); }
      .k-bg-primary { background-color: var(--kinetic-primary); color: #ffffff; }
      .k-focus:focus-visible { outline: 2px solid var(--kinetic-primary); outline-offset: 2px; }
    </style>
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="border-b border-slate-200 dark:border-slate-800">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-6 py-4">
        {SITE.logo && <img src={siteUrl('./', SITE.logo)} alt="" class="h-8 w-auto" />}
        <span class="text-lg font-semibold">{SITE.name}</span>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-12">
      {
        guides.length === 0 && walkthroughs.length === 0 ? (
          <div class="py-24 text-center">
            <h1 class="mb-3 text-2xl font-bold">No documentation found</h1>
            <p class="text-slate-600 dark:text-slate-400">
              Run <code class="rounded bg-slate-100 px-1.5 py-0.5 dark:bg-slate-800">pnpm build:pipeline</code> to
              generate the documentation first.
            </p>
          </div>
        ) : (
          <>
            <section class="mb-14 max-w-3xl">
              <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{SITE.name}</h1>
              <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">{SITE.description}</p>
              {firstGuide && (
                <div class="mt-8 flex flex-wrap gap-3">
                  <a href={firstGuide} class="k-bg-primary k-focus rounded-lg px-5 py-2.5 text-sm font-semibold hover:opacity-90">
                    Start reading
                  </a>
                  {explorerPath && knowledge && (
                    <a
                      href={explorerPath}
                      class="k-focus flex items-center gap-2 rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-900"
                    >
                      <Compass className="h-4 w-4" aria-hidden="true" /> Explore concepts
                    </a>
                  )}
                </div>
              )}
            </section>

            {groups.map((grp) => (
              <section class="mb-12" aria-labelledby={`cat-${grp.category}`}>
                <h2 id={`cat-${grp.category}`} class="mb-4 flex items-center gap-2 text-xl font-semibold">
                  <BookOpen className="h-5 w-5 k-text-primary" aria-hidden="true" /> {grp.label}
                </h2>
                <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {grp.guides.map((g) => (
                    <li>
                      <a href={guideUrl(g.slug)} class={card}>
                        <span class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
                          {DOC_TYPE_LABELS[g.docType] ?? g.docType}
                        </span>
                        <span class="mt-1 block font-semibold">{g.title}</span>
                        <span class="mt-2 line-clamp-3 block text-sm text-slate-600 dark:text-slate-400">{g.summary}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}

            {walkthroughs.length > 0 && (
              <section class="mb-12" aria-labelledby="walkthroughs">
                <h2 id="walkthroughs" class="mb-4 flex items-center gap-2 text-xl font-semibold">
                  <PlayCircle className="h-5 w-5 k-text-primary" aria-hidden="true" /> Step-by-step walkthroughs
                </h2>
                <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {walkthroughs.map((w) => (
                    <li>
                      <a href={w.url} class={card}>
                        <span class="flex items-center gap-2 font-semibold">
                          <FileText className="h-4 w-4 flex-shrink-0" aria-hidden="true" /> {w.title}
                        </span>
                        {w.description && (
                          <span class="mt-2 line-clamp-3 block text-sm text-slate-600 dark:text-slate-400">
                            {w.description}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </>
        )
      }
    </main>
  </body>
</html>
