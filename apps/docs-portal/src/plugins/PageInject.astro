---
/**
 * PageInject — injected after the article content on every page, before the
 * prev/next navigation.
 *
 * Receives page metadata as props so the injected component can be context-aware.
 */

interface Props {
  /** The current page ID (e.g. "create_project") */
  pageId: string;
  /** The current locale (e.g. "en-US") */
  locale: string;
  /** The current version (e.g. "v1.0") */
  version: string;
  /** Page title */
  title: string;
}

const { pageId, locale, version, title } = Astro.props;
