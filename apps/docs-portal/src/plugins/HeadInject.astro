/**
 * HeadInject — injected inside <head> on every page.
 *
 * Use this file for:
 *   - Analytics scripts (Google Analytics, Segment, Posthog, Plausible)
 *   - Custom web fonts (Google Fonts <link> tags)
 *   - Additional <meta> tags (Twitter cards, canonical URLs)
 *   - Content Security Policy headers
 *
 * ─── Examples ────────────────────────────────────────────────────────────────
 *
 * Google Analytics 4:
 *   <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXX"></script>
 *   <script>
 *     window.dataLayer = window.dataLayer || [];
 *     function gtag(){dataLayer.push(arguments);}
 *     gtag('js', new Date());
 *     gtag('config', 'G-XXXXXXXX');
 *   </script>
 *
 * Plausible Analytics:
 *   <script defer data-domain="docs.mycompany.com" src="https://plausible.io/js/script.js"></script>
 *
 * Google Fonts:
 *   <link rel="preconnect" href="https://fonts.googleapis.com" />
 *   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 *   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
 *
 * If you add a custom font here, also update the font-family in your CSS or
 * set it as a Tailwind `fontFamily` extension in tailwind.config.mjs.
 */
