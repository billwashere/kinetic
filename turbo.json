{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "test:docs": {
      "inputs": ["e2e-tests/**/*.ts", "src/lib/doc-extractor.ts"],
      "outputs": ["generated/**", "public/visual-cache/**"],
      "dependsOn": ["^build"]
    },
    "generate:audio": {
      "inputs": ["generated/**", "content/locales/**", "src/engine/**"],
      "outputs": ["public/audio-objects/**", "public/audio-manifest*.json"],
      "dependsOn": ["test:docs"]
    },
    "assemble": {
      "inputs": [
        "public/audio-manifest*.json",
        "public/visual-cache/**",
        "src/components/**",
        "src/index.tsx"
      ],
      "outputs": ["public/video-cache/**"],
      "dependsOn": ["generate:audio", "^build"]
    },
    "diff:check": {
      "inputs": ["generated/**/*.json"],
      "outputs": ["generated/**/diff-from-*.json", "generated/**/visual-diff/**"],
      "dependsOn": ["test:docs"],
      "cache": false
    },
    "build:pipeline": {
      "dependsOn": ["test:docs", "generate:audio", "assemble"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "build.mjs", "tsconfig.build.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@kinetic/docs-portal#build": {
      "inputs": [
        "src/**",
        "../../packages/engine/public/**",
        "../../packages/engine/generated/**",
        "../../packages/engine/dist/knowledge/**"
      ],
      "outputs": ["dist/**"],
      "dependsOn": ["@kinetic/engine#assemble", "@kinetic/engine#knowledge:compile"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:unit": {
      "inputs": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.ts", "src/**/*.tsx"]
    },
    "knowledge:validate": {
      "inputs": ["content/knowledge/**", "content/locales/**", "generated/**", "src/knowledge/**"],
      "outputs": []
    },
    "release:build": {
      "inputs": [
        "content/knowledge/**",
        "content/locales/**",
        "generated/**",
        "src/knowledge/**",
        "src/scripts/release-*.ts"
      ],
      "outputs": ["dist/release/**"],
      "dependsOn": ["knowledge:validate"]
    },
    "knowledge:compile": {
      "inputs": ["content/knowledge/**", "content/locales/**", "generated/**", "src/knowledge/**"],
      "outputs": ["dist/knowledge/**"],
      "dependsOn": ["knowledge:validate"]
    }
  }
}
