# Dependencies
node_modules/

# Turbo cache
.turbo/

# renderer-compat esbuild bundle cache (replaces .remotion-bundle-cache)
packages/engine/.rc-bundle-cache/

# Pipeline binary outputs — large files, regenerated by the pipeline
packages/engine/public/audio-objects/
packages/engine/public/visual-cache/
packages/engine/public/video-cache/

# Pipeline JSON outputs — commit these; they allow the Astro build to run
# without re-running the full pipeline (audio manifests & skeleton are small)
# packages/engine/public/audio-manifest-*.json  ← intentionally NOT ignored
# packages/engine/generated/                    ← intentionally NOT ignored

# Environment — never commit real keys
.env
.env.local

# Playwright saved auth state — contains live session tokens, never commit
packages/engine/.auth/

# Kokoro / HuggingFace model cache — large binary weights, re-downloaded on demand
# (stored in ~/.cache/huggingface/hub/ by default, but may be overridden via HF_HOME)
.cache/

# Layer config assets — commit small logos (<1 MB); use Git LFS for music files
# packages/engine/public/assets/*.mp3  ← consider Git LFS for audio (can be 5–30 MB)
# packages/engine/public/assets/*.png  ← logos are fine to commit directly

# Build outputs
dist/

# OS
.DS_Store
